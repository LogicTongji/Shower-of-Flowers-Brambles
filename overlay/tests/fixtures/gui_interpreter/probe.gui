guiTypes = {
	windowType = {
		name = "probe_window"
		position = { x = 10 y = 20 }
		size = { x = 480 y = 320 }
		moveable = yes
		dragHeight = 32
		frameZOrder = 250

		iconType = {
			name = "probe_panel"
			spriteType = "GFX_probe_panel"
			position = { x = 0 y = 0 }
			size = { x = 480 y = 320 }
		}

		textBoxType = {
			name = "probe_title"
			font = "probe_font"
			fontSize = 18
			alignment = "center"
			textSource = "title"
			position = { x = 20 y = 12 }
			size = { x = 200 y = 24 }
		}

		progressBarType = {
			name = "probe_progress"
			progressBar = "probe_progress_resource"
			valueSource = "progress"
			visibleWhen = "state.visible"
			position = { x = 20 y = 48 }
			size = { x = 160 y = 16 }
		}

		indexedMapType = {
			name = "probe_map"
			mapResource = "GFX_probe_indexed_map"
			valueSource = "items.{id}.value"
			onClick = "select_item"
			visibleWhen = "state.visible"
			position = { x = 220 y = 48 }
			size = { x = 220 y = 220 }
		}

		listBoxType = {
			name = "probe_list"
			position = { x = 20 y = 88 }
			size = { x = 160 y = 140 }
			clipChildren = yes
			itemTemplate = "probe_list_item"
			scrollbarType = "probe_scrollbar"
			spacing = 4
		}

		scrollbarType = {
			name = "probe_scrollbar"
			position = { x = 184 y = 88 }
			size = { x = 8 y = 140 }
			slider = "GFX_probe_thumb"
			track = "GFX_probe_track"
		}

		guiButtonType = {
			name = "probe_list_item"
			quadTextureSprite = "GFX_probe_panel"
			onClick = "activate_item"
			enabledWhen = "state.visible"
			font = "probe_font"
			fontSize = 14
			alignment = "center"
			position = { x = 0 y = 0 }
			size = { x = 150 y = 28 }

			iconType = {
				name = "probe_list_icon"
				spriteSource = "item.sprite"
				position = { x = 4 y = 4 }
				size = { x = 20 y = 20 }
			}

			textBoxType = {
				name = "probe_list_label"
				font = "probe_font"
				fontSize = 12
				textSource = "items.{id}.label"
				visibleWhen = "items.{id}.visible"
				position = { x = 28 y = 4 }
				size = { x = 92 y = 20 }
			}

			guiButtonType = {
				name = "probe_list_nested"
				quadTextureSprite = "GFX_probe_panel"
				onClick = "activate_item"
				position = { x = 126 y = 4 }
				size = { x = 20 y = 20 }
			}
		}

		listBoxType = {
			name = "probe_polar_list"
			position = { x = 220 y = 80 }
			size = { x = 200 y = 100 }
			itemTemplate = "probe_polar_item"
			layout = "polar"
			polarCenter = { x = 100 y = 90 }
			polarInnerRadius = 70
			polarRingItemCounts = { 6 }
			polarStartAngle = 180
			polarEndAngle = 360
		}

		guiButtonType = {
			name = "probe_polar_item"
			spriteType = "GFX_probe_panel"
			position = { x = 0 y = 0 }
			size = { x = 10 y = 10 }
		}

		iconType = {
			name = "probe_drag_track"
			spriteType = "GFX_probe_panel"
			position = { x = 20 y = 250 }
			size = { x = 160 y = 10 }
		}

		iconType = {
			name = "probe_drag_cursor"
			spriteType = "GFX_probe_panel"
			position = { x = 20 y = 250 }
			size = { x = 10 y = 10 }
			draggable = yes
			dragAxis = "horizontal"
			dragTrack = "probe_drag_track"
			dragValueSource = "probe.drag.value"
			dragMinimum = 0
			dragMaximum = 10
			dragSteps = 11
			onPress = "probe_drag_press"
			onDragStart = "probe_drag_start"
			onDrag = "probe_drag"
			onDragEnd = "probe_drag_end"
		}
	}
}
